{
  "name": "pcascade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:verify": "tsx scripts/verify-database.mts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.mts",
    "smoke:http": "tsx tests/e2e/http-smoke.mts",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "db:test:down": "docker compose down",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "effect": "3.22.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "3.11.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "papaparse": "5.7.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.20",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
